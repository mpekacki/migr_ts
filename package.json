{
  "name": "migr_ts",
  "version": "1.23.0",
  "bin": "main.js",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs --outfile=bundle.js",
    "release": "node build.mjs --outfile=build/bundle.js && node -e \"const fs=require('fs');const p=require('./package.json');const d='build/v'+p.version;fs.mkdirSync(d,{recursive:true});fs.copyFileSync('build/bundle.js',d+'/bundle.js')\"",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --config=jest.config.ci.js --no-coverage --passWithNoTests",
    "test:parallel": "jest --maxWorkers=3 --verbose",
    "test:parallel:max": "jest --maxWorkers=50% --verbose",
    "test:sequential": "jest --runInBand --verbose",
    "start": "node build/bundle.js",
    "start:test": "node bundle.js"
  },
  "keywords": [
    "salesforce",
    "data-migration",
    "sfdx",
    "jsforce",
    "cli"
  ],
  "author": "Marcel Pekacki",
  "license": "ISC",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "CLI tool for migrating Salesforce records between orgs, with automatic relationship resolution, circular dependency handling, and configurable error solvers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpekacki/migr_ts.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.13",
    "esbuild": "0.25.5",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  },
  "dependencies": {
    "@salesforce/core": "^8.6.2",
    "@types/jsforce": "^1.11.5",
    "@types/terminal-kit": "^2.5.6",
    "commander": "^12.1.0",
    "jsforce": "^3.5.2",
    "terminal-kit": "^3.1.1"
  }
}
